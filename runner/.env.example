# The Worker's public URL, e.g. https://school-docs-manager.yourname.workers.dev
WORKER_URL=

# Must match the RUNNER_TOKEN secret set on the Worker (wrangler secret put RUNNER_TOKEN)
RUNNER_TOKEN=

# Backblaze B2 — Application Keys page in the B2 console
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
